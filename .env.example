# --- Vertex AI (recommended — uses GCP credits) ---
# Authenticate locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Google AI Studio (alternative — uses API key only) ---
# GEMINI_API_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGIN=http://localhost:3000

# --- Langfuse observability (optional) ---
# Get keys from https://cloud.langfuse.com → Settings → API Keys
# EU:  LANGFUSE_HOST=https://cloud.langfuse.com
# US:  LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse observability — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
